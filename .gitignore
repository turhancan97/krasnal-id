# Local environment and secrets
.env
.env.*
!.env.example

# Downloaded and generated research artifacts. No trailing slash: these paths are
# often symlinks to bulk storage, and a directory-only pattern would not match one.
data/images
data/field-queries
data/embeddings
data/splits
data/discovery
data/manifest*.json
results/*
!results/README.md

# Figures selected for publication are tracked under docs/figures/.

# Model and experiment caches
.cache/
outputs/
multirun/
*.npy
*.npz
*.pt
*.pth

# Build-time dependencies for the static demo.
docs/demo/node_modules/
