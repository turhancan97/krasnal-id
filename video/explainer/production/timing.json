  "cues": [
    {
      "start": 0.4,
      "end": 2.7375,
      "text": "Across Wrocław, bronze dwarves share"
    },
    {
      "start": 2.7375,
      "end": 4.3125,
      "text": "poses and props."
    },
    {
      "start": 4.3125,
      "end": 6.025,
      "text": "Given a photograph, which individual"
    },
    {
      "start": 6.025,
      "end": 7.75,
      "text": "statue are we looking at?"
    },
    {
      "start": 7.75,
      "end": 11.146666666666668,
      "text": "Meet Doppeldwarf-306."
    },
    {
      "start": 11.691666666666668,
      "end": 14.079166666666667,
      "text": "A frozen vision model turns each image"
    },
    {
      "start": 14.079166666666667,
      "end": 16.391666666666666,
      "text": "into a vector: a numerical visual"
    },
    {
      "start": 16.391666666666666,
      "end": 17.554166666666667,
      "text": "description."
    },
    {
      "start": 17.554166666666667,
      "end": 20.516666666666666,
      "text": "Cosine similarity compares these vectors."
    },
    {
      "start": 20.516666666666666,
      "end": 22.56666666666667,
      "text": "Similar directions suggest similar"
    },
    {
      "start": 22.56666666666667,
      "end": 23.416666666666668,
      "text": "appearance;"
    },
    {
      "start": 23.416666666666668,
      "end": 25.241666666666667,
      "text": "they do not prove identity."
    },
    {
      "start": 25.241666666666667,
      "end": 27.241666666666667,
      "text": "We rank each statue by its best"
    },
    {
      "start": 27.241666666666667,
      "end": 28.929166666666667,
      "text": "reference photograph, without"
    },
    {
      "start": 28.929166666666667,
      "end": 30.646666666666665,
      "text": "fine-tuning the model."
    },
    {
      "start": 31.241666666666664,
      "end": 33.09166666666666,
      "text": "Now add more candidates."
    },
    {
      "start": 33.09166666666666,
      "end": 35.30416666666667,
      "text": "Do lookalikes overwhelm retrieval?"
    },
    {
      "start": 35.30416666666667,
      "end": 37.666666666666664,
      "text": "Instead of reporting one accuracy number,"
    },
    {
      "start": 37.666666666666664,
      "end": 39.791666666666664,
      "text": "we repeatedly sample larger candidate"
    },
    {
      "start": 39.791666666666664,
      "end": 41.74166666666666,
      "text": "pools, always keeping the correct"
    },
    {
      "start": 41.74166666666666,
      "end": 42.99166666666666,
      "text": "statue."
    },
    {
      "start": 42.99166666666666,
      "end": 45.65416666666667,
      "text": "DINOv2's accuracy falls slowly;"
    },
    {
      "start": 45.65416666666667,
      "end": 47.27916666666667,
      "text": "CLIP's falls faster."
    },
    {
      "start": 47.27916666666667,
      "end": 49.24666666666667,
      "text": "The curve is the result."
    },
    {
      "start": 49.81666666666666,
      "end": 51.891666666666666,
      "text": "Surely location solves this?"
    },
    {
      "start": 51.891666666666666,
      "end": 53.829166666666666,
      "text": "But nearby lookalikes survive a hard"
    },
    {
      "start": 53.829166666666666,
      "end": 55.454166666666666,
      "text": "geographic filter."
    },
    {
      "start": 55.454166666666666,
      "end": 58.09166666666667,
      "text": "In simulation, a soft distance bonus"
    },
    {
      "start": 58.09166666666667,
      "end": 59.329166666666666,
      "text": "works better."
    },
    {
      "start": 59.329166666666666,
      "end": 62.05416666666667,
      "text": "Across 294 placed statues,"
    },
    {
      "start": 62.05416666666667,
      "end": 63.69166666666666,
      "text": "DINOv2 rises from"
    },
    {
      "start": 63.69166666666666,
      "end": 66.74166666666667,
      "text": "93.4 to 98.7"
    },
    {
      "start": 66.74166666666667,
      "end": 68.89166666666667,
      "text": "percent for users twenty-five metres"
    },
    {
      "start": 68.89166666666667,
      "end": 70.51333333333334,
      "text": "away."
    },
    {
      "start": 71.05833333333335,
      "end": 72.63333333333334,
      "text": "A new photographer brings different"
    },
    {
      "start": 72.63333333333334,
      "end": 75.19583333333334,
      "text": "viewpoints, backgrounds, and lighting."
    },
    {
      "start": 75.19583333333334,
      "end": 76.44583333333334,
      "text": "Accuracy drops;"
    },
    {
      "start": 76.44583333333334,
      "end": 78.20833333333334,
      "text": "fewer reference photographs also"
    },
    {
      "start": 78.20833333333334,
      "end": 79.40833333333335,
      "text": "contribute."
    },
    {
      "start": 79.40833333333335,
      "end": 81.68333333333335,
      "text": "LoFTR matches local details across"
    },
    {
      "start": 81.68333333333335,
      "end": 82.88333333333334,
      "text": "photographs."
    },
    {
      "start": 82.88333333333334,
      "end": 85.43333333333335,
      "text": "Geometric consistency adds evidence to"
    },
    {
      "start": 85.43333333333335,
      "end": 87.45833333333334,
      "text": "visual similarity, moving a better"
    },
    {
      "start": 87.45833333333334,
      "end": 89.24666666666666,
      "text": "match up the shortlist."
    },
    {
      "start": 89.79166666666667,
      "end": 92.09166666666667,
      "text": "Finally, high similarity need not mean"
    },
    {
      "start": 92.09166666666667,
      "end": 93.55416666666666,
      "text": "a known statue."
    },
    {
      "start": 93.55416666666666,
      "end": 95.27916666666667,
      "text": "Comparing the best two candidates"
    },
    {
      "start": 95.27916666666667,
      "end": 97.15416666666667,
      "text": "exposes ambiguity."
    },
    {
      "start": 97.15416666666667,
      "end": 99.47916666666667,
      "text": "This margin reduces false acceptance in"
    },
    {
      "start": 99.47916666666667,
      "end": 100.51666666666667,
      "text": "the research;"
    },
    {
      "start": 100.51666666666667,
      "end": 102.67916666666666,
      "text": "the browser demo uses a separately"
    },
    {
      "start": 102.67916666666666,
      "end": 104.64666666666666,
      "text": "measured close-call hint."
    },
    {
      "start": 105.16666666666667,
      "end": 107.25416666666668,
      "text": "The lesson: test the pool, the place,"
    },
    {
      "start": 107.25416666666668,
      "end": 108.65416666666667,
      "text": "and the photographer."
    },
    {
      "start": 108.65416666666667,
      "end": 110.40416666666667,
      "text": "Explore the dataset, and try the"
    },
    {
      "start": 110.40416666666667,
      "end": 111.88,
      "text": "identifier."
    }
  ],
